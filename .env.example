# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF

# Secret for the Telegram webhook (must match secret_token passed to setWebhook).
# If set, the webhook only accepts requests signed with this header.
TG_WEBHOOK_SECRET=change-me

# Turso (libSQL) database
TURSO_URL=libsql://your-db.turso.io
TURSO_TOKEN=your-turso-auth-token

# AI provider (any OpenAI-compatible endpoint)
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_BASE=https://api.openai.com/v1

# Request timeout for AI calls, in milliseconds
AI_TIMEOUT_MS=30000

# Max age of Telegram initData in seconds (default 30 days; 0 disables the check)
INITDATA_MAX_AGE_SEC=2592000

# Accept initData without signature verification. DANGEROUS:
# with it enabled anyone can impersonate any Telegram user. Keep it off in production.
ALLOW_UNVERIFIED=0

# Public URL of the mini app (for links inside answers)
WEBAPP_URL=https://your-app.agent.mira.tg

# Secret for admin endpoints (/api/admin/plan)
ADMIN_SECRET=change-me

PORT=3000
